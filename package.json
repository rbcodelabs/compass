{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=screenshots",
    "test:e2e:functional": "E2E_FUNCTIONAL=1 playwright test --project=functional-setup --project=functional",
    "test:e2e:all": "E2E_FUNCTIONAL=1 playwright test",
    "docs:screenshots": "playwright test --project=screenshots e2e/screenshots.spec.ts"
  },
