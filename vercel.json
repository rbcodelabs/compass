{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/import-asset-cleanup",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/agent-run-sweeper",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/agent-wakeups",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/agent-orchestrator",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/agent-retention",
      "schedule": "30 6 * * *"
    }
  ]
}
