# ── Local development ───────────────────────────────────────────────────────
# Point at a local PostgreSQL instance. When DATABASE_URL is set, lib/db.ts
# connects with plain pg and no AWS involvement; when it is absent it requires
# PGHOST and signs Aurora DSQL tokens (the deployed path).
#
# Environments are isolated by SCHEMA inside one database, not by separate
# databases: NODE_ENV=development resolves to `compass_dev` (see lib/schema.ts).
# Create the tables with `pnpm exec prisma db push`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5437/compass?sslmode=disable

# Overrides the `compass` schema-name prefix. Rarely needed locally.
# PGSCHEMA=compass

# ── Authentication (REQUIRED) ───────────────────────────────────────────────
# NextAuth signs and encrypts session cookies with this. Without it every
# request throws `MissingSecret` and the app is unusable — you get an error
# page rather than a login form, which reads like a broken build rather than
# a missing variable. This was previously undocumented here, and a fresh
# worktree that did not inherit an existing .env.local hit exactly that.
#
# Any high-entropy string works locally; generate one with:
#   openssl rand -base64 32
# Deployed environments take their own value from Vercel env vars — do not
# reuse a local value there, and never commit a real one to this file.
AUTH_SECRET=

# ── Feature flags ───────────────────────────────────────────────────────────
# Capture research is fail-closed in production.
COMPASS_RESEARCH_CAPTURE_ENABLED=0

# Production only: =1 mirrors Solution <-> Key Result links into entity_links (ADR phase 4). Off in production unless 1;
# on by default elsewhere. The legacy table stays the source of truth. Turn it on BEFORE POSTing the explicit-only backfill
# 098_entity_links_backfill_solution_key_result.
# COMPASS_ENTITY_LINKS_SOLUTION_KR_MIRROR=1

# Production only: =1 mirrors Opportunity <-> Objective links (origin DIRECT/LEGACY kept) and the Opportunity -> Key Result pointer
# (linked_key_result_id) into entity_links (ADR phase 5). Off in production unless 1; on by default elsewhere. The legacy table and
# column stay the source of truth. Turn it on BEFORE POSTing the explicit-only backfill 095_entity_links_backfill_opportunity.
# COMPASS_ENTITY_LINKS_OPPORTUNITY_MIRROR=1

# Production only: =1 mirrors Artifact -> Solution and Artifact -> Decision links (artifact_links) into entity_links (ADR phase 6).
# Off in production unless 1; on by default elsewhere. The legacy table stays the source of truth. Turn it on BEFORE POSTing the
# explicit-only backfill 096_entity_links_backfill_artifact.
# COMPASS_ENTITY_LINKS_ARTIFACT_MIRROR=1

# Production only: =1 mirrors task links (TASK_REFERENCES; the nine task-link target types, DECISION stored as REVIEW_REQUEST) into
# entity_links (ADR phase 7). Off in production unless exactly 1; on by default elsewhere. The legacy task_links table stays the source of
# truth; removals always run. Turn it on BEFORE POSTing the explicit-only backfill 097_entity_links_backfill_task.
# COMPASS_ENTITY_LINKS_TASK_MIRROR=1

# entity_links read flip, one flag per family (SOLUTION_KR, OPPORTUNITY, ARTIFACT, TASK): off | shadow | on. Fail-closed: only the exact
# strings shadow / on count, anything else (and unset, in every environment) is off. shadow serves the legacy result and compares it with
# entity_links; on serves entity_links; rollback is off. No reader is routed through these yet (PR A); parity is in GET /api/admin/migrate
# under entityLinksReadParity. See docs/maintenance/entity-links-*-backfill.md.
# COMPASS_ENTITY_LINKS_SOLUTION_KR_READ=off
# COMPASS_ENTITY_LINKS_OPPORTUNITY_READ=off
# COMPASS_ENTITY_LINKS_ARTIFACT_READ=off
# COMPASS_ENTITY_LINKS_TASK_READ=off

# Reserved for the replacement authoritative transport. This cannot activate
# the legacy browser-authoritative transport in production.
COMPASS_RESEARCH_AUTHORITATIVE_VOICE_ENABLED=0

# Customer-discovery voice requires this and the authoritative-voice flag in production.
COMPASS_RESEARCH_DISCOVERY_VOICE_ENABLED=0

# Required in each deployed environment before enabling capability packs.
# Must identify a PRIVATE Blob store; never reuse the general public Blob token.
CAPABILITY_PACK_BLOB_READ_WRITE_TOKEN=

# HTML prototypes use a dedicated PRIVATE Blob store in each deployed environment.
# Keep production and preview stores separate; never reuse the public Blob token.
ARTIFACT_BLOB_READ_WRITE_TOKEN=
# Enable only after the registered 060_workspace_updates migration is verified.
# Defaults off; captures new events only (no historical backfill).
WORKSPACE_UPDATES_ENABLED=0

# Following and in-app notifications. Enable only after the registered
# 068_follows_notifications migration is verified. Defaults off; every entry
# point is a no-op until the flag is on and the tables exist. Slice 1 ships the
# infrastructure only, so nothing is user-visible even with the flag on.
FOLLOWING_ENABLED=0

# ── Product analytics (opt-in, production activation is separately authorized) ──
# Dedicated base64-encoded 32-byte key for provider credentials and the
# domain-separated telemetry relay HMAC. Never reuse the SSO encryption key.
# Generate/store securely; do not commit a real value. Keep stable across deploys.
ANALYTICS_SECRET_ENCRYPTION_KEY=
# Only this workspace can access installation-wide Active Discovery Teams.
COMPASS_ANALYTICS_REPORTING_WORKSPACE_ID=
# Actual prospective UTC collection start (ISO8601); never backdate for coverage.
COMPASS_ANALYTICS_COLLECTION_STARTED_AT=
# Optional comma-separated demo/test workspace IDs. Real dogfood may be included.
COMPASS_ANALYTICS_EXCLUDED_WORKSPACE_IDS=
# Vercel supplies VERCEL_PROJECT_PRODUCTION_URL (hostname only) to the fixed-path
# server event relay. No events leave preview/local environments.

# ── In-app agent model provider ─────────────────────────────────────────────
# Default is Anthropic's API; only the key for the selected provider is needed.
#   AGENT_MODEL_PROVIDER=anthropic   (default)  needs ANTHROPIC_API_KEY
#   AGENT_MODEL_PROVIDER=bedrock                needs BEDROCK_API_KEY (an AWS
#     Bedrock long-lived API key / bearer token, not SigV4 access keys)
# A blank or whitespace-only key is rejected before a sandbox is started.
# AGENT_HARNESS is the outer choice (claude default | opencode). The provider
# settings below apply to the claude harness only; with AGENT_HARNESS=opencode
# they are ignored and only the AI Gateway credential is passed to the sandbox.
# AGENT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BEDROCK_API_KEY=
# AWS_REGION=us-east-1
# Optional model override. Defaults: anthropic -> claude-sonnet-5,
# bedrock -> global.anthropic.claude-sonnet-5-5 (an inference profile id).
# AGENT_MODEL_ID=
