# ── Local development ───────────────────────────────────────────────────────
# Point at a local PostgreSQL instance. When DATABASE_URL is set, lib/db.ts
# connects with plain pg and no AWS involvement; when it is absent it requires
# PGHOST and signs Aurora DSQL tokens (the deployed path).
#
# Environments are isolated by SCHEMA inside one database, not by separate
# databases: NODE_ENV=development resolves to `compass_dev` (see lib/schema.ts).
# Create the tables with `pnpm exec prisma db push`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5437/compass?sslmode=disable

# Overrides the `compass` schema-name prefix. Rarely needed locally.
# PGSCHEMA=compass

# ── Authentication (REQUIRED) ───────────────────────────────────────────────
# NextAuth signs and encrypts session cookies with this. Without it every
# request throws `MissingSecret` and the app is unusable — you get an error
# page rather than a login form, which reads like a broken build rather than
# a missing variable. This was previously undocumented here, and a fresh
# worktree that did not inherit an existing .env.local hit exactly that.
#
# Any high-entropy string works locally; generate one with:
#   openssl rand -base64 32
# Deployed environments take their own value from Vercel env vars — do not
# reuse a local value there, and never commit a real one to this file.
AUTH_SECRET=

# Vercel Connect connector UID (e.g. google/compass) that holds Compass's Google
# OAuth client. Serves both Google sign-in and the Google Drive MCP connector.
# Required, no default: unset hides Google sign-in (magic link and passkey keep
# working) and shows Drive as "Not configured on this deployment". Deployed
# environments only; the connector must be linked to the project and environment
# in Vercel Connect. This replaces AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET and
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET, which can be deleted once production is
# verified.
# COMPASS_GOOGLE_CONNECTOR=

# Vercel Connect connector UID (e.g. github/compass) for the Compass GitHub App.
# Connect holds the App's private key and mints short-lived installation tokens;
# Compass requests them refined to the workspace's approved repos with
# contents:write, pull_requests:write, metadata:read. Optional, no default: unset
# means agent turns run without GitHub push access and the repo allowlist cannot
# be saved. Deployed environments only; link the connector to the project and
# environment in Vercel Connect. Replaces GITHUB_APP_ID/GITHUB_PRIVATE_KEY.
# COMPASS_GITHUB_CONNECTOR=

# ── Feature flags ───────────────────────────────────────────────────────────
# Product features (research capture, PM interviews, research voice, workspace updates, following, the marketing launch
# workflow) are NOT environment flags: a workspace administrator turns them on in Settings > Modules. See docs/adr-workspace-modules.md.
# Only infrastructure and secrets stay here, plus COMPASS_PASSKEYS_ENABLED (a user/auth capability).

# The COMPASS_ENTITY_LINKS_*_MIRROR and COMPASS_ENTITY_LINKS_*_READ switches are retired: entity_links is the only link store and the code
# ignores them. They can be deleted from every environment (docs/maintenance/entity-links-rollout-runbook.md, step 7).

# Required in each deployed environment before enabling capability packs.
# Must identify a PRIVATE Blob store; never reuse the general public Blob token.
CAPABILITY_PACK_BLOB_READ_WRITE_TOKEN=

# HTML prototypes use a dedicated PRIVATE Blob store in each deployed environment.
# Keep production and preview stores separate; never reuse the public Blob token.
ARTIFACT_BLOB_READ_WRITE_TOKEN=
# ── Product analytics (opt-in, production activation is separately authorized) ──
# Dedicated base64-encoded 32-byte key for provider credentials and the
# domain-separated telemetry relay HMAC. Never reuse the SSO encryption key.
# Generate/store securely; do not commit a real value. Keep stable across deploys.
ANALYTICS_SECRET_ENCRYPTION_KEY=
# Only this workspace can access installation-wide Active Discovery Teams.
COMPASS_ANALYTICS_REPORTING_WORKSPACE_ID=
# Actual prospective UTC collection start (ISO8601); never backdate for coverage.
COMPASS_ANALYTICS_COLLECTION_STARTED_AT=
# Optional comma-separated demo/test workspace IDs. Real dogfood may be included.
COMPASS_ANALYTICS_EXCLUDED_WORKSPACE_IDS=
# Vercel supplies VERCEL_PROJECT_PRODUCTION_URL (hostname only) to the fixed-path
# server event relay. No events leave preview/local environments.

# ── In-app agent model provider ─────────────────────────────────────────────
# Default is Anthropic's API; only the key for the selected provider is needed.
#   AGENT_MODEL_PROVIDER=anthropic   (default)  needs ANTHROPIC_API_KEY
#   AGENT_MODEL_PROVIDER=bedrock                needs BEDROCK_API_KEY (an AWS
#     Bedrock long-lived API key / bearer token, not SigV4 access keys)
#   AGENT_MODEL_PROVIDER=claude-subscription   needs CLAUDE_CODE_OAUTH_TOKEN
#     OPERATOR-ONLY, SELF-HOSTED ONLY. WARNING: Anthropic's terms restrict Claude
#     subscription tokens to personal use of Claude Code. Do NOT enable this on any
#     deployment that serves other users (the token would be spent on their runs).
#     Env var only: no settings UI, nothing stored in the database. Re-check
#     Anthropic's current terms before turning it on. It is used only when
#     AGENT_MODEL_PROVIDER is exactly "claude-subscription"; otherwise
#     CLAUDE_CODE_OAUTH_TOKEN is ignored. A workspace's own API key (Settings >
#     Anthropic API key) still takes precedence over it.
# A blank or whitespace-only key is rejected before a sandbox is started.
# Which credential paid for a run: every agent run logs one server line,
#   agent-run credential source=<platform-api-key|workspace-api-key|claude-subscription|bedrock|gateway> runId=<id> workspaceId=<id>
# Find it by searching Vercel runtime logs for "agent-run credential source". The
# line never contains the key, token, or any part of one. Nothing is stored in
# the database and nothing is shown in the UI.
# AGENT_HARNESS is the outer choice (claude default | opencode). The provider
# settings below apply to the claude harness only; with AGENT_HARNESS=opencode
# they are ignored and only the AI Gateway credential is passed to the sandbox.
# AGENT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BEDROCK_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=   (claude-subscription only; read the warning above)
# AWS_REGION=us-east-1
# Optional model override. Defaults: anthropic -> claude-sonnet-5,
# bedrock -> global.anthropic.claude-sonnet-5-5 (an inference profile id).
# AGENT_MODEL_ID=

# ── Platform admin (optional) ───────────────────────────────────────────────
# Comma-separated, case-insensitive emails allowed to open
# /settings/admin/agent-snapshot and rebuild the in-app agent's golden
# Vercel Sandbox snapshot from the browser. Unset or empty means nobody
# (fail closed). This is separate from MIGRATION_SECRET, which stays
# server-to-server only.
# PLATFORM_ADMIN_EMAILS=you@example.com
