# Capture research is fail-closed in production.
COMPASS_RESEARCH_CAPTURE_ENABLED=0

# Reserved for the replacement authoritative transport. This cannot activate
# the legacy browser-authoritative transport in production.
COMPASS_RESEARCH_AUTHORITATIVE_VOICE_ENABLED=0

# Customer-discovery voice requires this and the authoritative-voice flag in production.
COMPASS_RESEARCH_DISCOVERY_VOICE_ENABLED=0
