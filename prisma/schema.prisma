generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────
// DSQL constraints applied:
//  - UUID PKs via gen_random_uuid()
//  - No @updatedAt (DSQL does not support trigger-based auto-update)
//  - relationMode = "prisma" already set — no FK constraints generated

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")

  organizationMembers OrganizationMember[]
  workspaceMembers    WorkspaceMember[]
  apiKeys             ApiKey[]
  agentConversations  AgentConversation[]

  @@map("users")
}

model Account {
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id])
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(100)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?  @db.VarChar(50)
  scope             String?
  id_token          String?
  session_state     String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(512)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(512)
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Multi-tenancy ────────────────────────────────────────────────────────────

model Organization {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String               @unique @db.VarChar(255)
  name          String               @db.VarChar(255)
  createdAt     DateTime             @default(now()) @map("created_at")
  workspaces    Workspace[]
  members       OrganizationMember[]
  scoringModels ScoringModel[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @default("MEMBER") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Workspace {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  slug                 String                  @db.VarChar(255)
  name                 String                  @db.VarChar(255)
  description          String?                 @db.Text
  feedbackEnabled      Boolean?                @default(false) @map("feedback_enabled")
  roadmapPublic        Boolean?                @default(false) @map("roadmap_public")
  portalAuthRequired   Boolean?                @default(false) @map("portal_auth_required")
  brandingPaletteId    String?                 @map("branding_palette_id") @db.VarChar(50)
  brandingPrimaryHex   String?                 @map("branding_primary_hex") @db.VarChar(7)
  brandingFontPresetId String?                 @map("branding_font_preset_id") @db.VarChar(50)
  brandingFontFamily   String?                 @map("branding_font_family") @db.VarChar(100)
  brandingLogoUrl      String?                 @map("branding_logo_url") @db.Text
  ssoEnabled           Boolean?                @default(false) @map("sso_enabled")
  // Ciphertext of the raw SSO shared secret (reversible AES-256-GCM
  // encryption via lib/crypto-secrets.ts, not a hash) — Compass must be
  // able to decrypt it to verify inbound customer-signed JWTs. The
  // plaintext is shown to the customer once, at generation time, and
  // never stored or re-displayed. Known v1 limitation: regenerating
  // overwrites the old secret outright — no rotation grace window.
  ssoSecretEncrypted   String?                 @map("sso_secret_encrypted") @db.Text
  // When the SSO secret was last (re)generated — separate from the
  // workspace's general `updatedAt` because that field is also bumped by
  // unrelated actions (e.g. branding updates), which would otherwise make
  // a "last rotated" timestamp in the settings UI lie.
  ssoSecretUpdatedAt   DateTime?               @map("sso_secret_updated_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @default(now()) @map("updated_at")
  organization         Organization            @relation(fields: [organizationId], references: [id])
  members              WorkspaceMember[]
  okrCycles            OKRCycle[]
  opportunities        Opportunity[]
  experiments          Experiment[]
  roadmapItems         RoadmapItem[]
  customFieldDefs      CustomFieldDefinition[]
  squads               Squad[]
  feedback             FeedbackItem[]
  docs                 Doc[]
  scoringConfig        WorkspaceScoringConfig?
  evidence             Evidence[]
  canvasNodePositions  CanvasNodePosition[]
  checklistTemplates   ChecklistTemplate[]
  tasks                Task[]
  agentConversations   AgentConversation[]

  @@unique([organizationId, slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("MEMBER") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ─── OKRs ─────────────────────────────────────────────────────────────────────

model OKRCycle {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  title       String      @db.VarChar(255)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  status      String      @default("DRAFT") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @map("updated_at")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  objectives  Objective[]

  @@map("okr_cycles")
}

model Objective {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId           String      @map("cycle_id") @db.Uuid
  squadId           String?     @map("squad_id") @db.Uuid
  parentKeyResultId String?     @map("parent_key_result_id") @db.Uuid
  title             String      @db.VarChar(255)
  description       String?     @db.Text
  owner             String?     @db.VarChar(255)
  status            String      @default("ON_TRACK") @db.VarChar(50)
  sortOrder         Int         @default(0) @map("sort_order")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @map("updated_at")
  cycle             OKRCycle    @relation(fields: [cycleId], references: [id])
  squad             Squad?      @relation(fields: [squadId], references: [id])
  parentKeyResult   KeyResult?  @relation("SquadKRSupport", fields: [parentKeyResultId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyResults        KeyResult[]
  createdById       String?     @map("created_by_id") @db.Uuid
  updatedById       String?     @map("updated_by_id") @db.Uuid
  source            String      @default("UI") @map("source") @db.VarChar(20)

  @@map("objectives")
}

model KeyResult {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectiveId          String        @map("objective_id") @db.Uuid
  title                String        @db.VarChar(255)
  target               Float
  current              Float         @default(0)
  unit                 String?       @db.VarChar(50)
  sortOrder            Int           @default(0) @map("sort_order")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @map("updated_at")
  objective            Objective     @relation(fields: [objectiveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkIns             CheckIn[]
  roadmapItems         RoadmapItem[]
  opportunities        Opportunity[]
  supportingObjectives Objective[]   @relation("SquadKRSupport")
  createdById          String?       @map("created_by_id") @db.Uuid
  updatedById          String?       @map("updated_by_id") @db.Uuid
  source               String        @default("UI") @map("source") @db.VarChar(20)

  @@map("key_results")
}

model CheckIn {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyResultId String    @map("key_result_id") @db.Uuid
  value       Float
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id])
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  source      String    @default("UI") @map("source") @db.VarChar(20)

  @@map("check_ins")
}

// ─── Discovery / OST ──────────────────────────────────────────────────────────

model Opportunity {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  squadId           String?           @map("squad_id") @db.Uuid
  title             String            @db.VarChar(255)
  description       String?           @db.Text
  customerSegment   String?           @map("customer_segment") @db.VarChar(255)
  status            String            @default("EXPLORING") @db.VarChar(50)
  sortOrder         Int               @default(0) @map("sort_order")
  linkedKeyResultId String?           @map("linked_key_result_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @map("updated_at")
  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  squad             Squad?            @relation(fields: [squadId], references: [id])
  linkedKeyResult   KeyResult?        @relation(fields: [linkedKeyResultId], references: [id])
  solutions         Solution[]
  roadmapItems      RoadmapItem[]
  feedback          FeedbackItem[]
  score             OpportunityScore?
  createdById       String?           @map("created_by_id") @db.Uuid
  updatedById       String?           @map("updated_by_id") @db.Uuid
  source            String            @default("UI") @map("source") @db.VarChar(20)
  evidence          Evidence[]

  @@map("opportunities")
}

model Solution {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId String            @map("opportunity_id") @db.Uuid
  title         String            @db.VarChar(255)
  description   String?           @db.Text
  status        String            @default("IDEA") @db.VarChar(50)
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @map("updated_at")
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id])
  assumptions   Assumption[]
  roadmapItems  RoadmapItem[]
  createdById   String?           @map("created_by_id") @db.Uuid
  updatedById   String?           @map("updated_by_id") @db.Uuid
  source        String            @default("UI") @map("source") @db.VarChar(20)
  evidence      Evidence[]
  comments      SolutionComment[]

  @@map("solutions")
}

model SolutionComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solutionId  String   @map("solution_id") @db.Uuid
  /// One of: PLAN | COMMENT
  commentType String   @default("COMMENT") @map("comment_type") @db.VarChar(20)
  body        String   @db.Text
  authorName  String   @map("author_name") @db.VarChar(255)
  /// One of: AGENT | HUMAN
  authorType  String   @default("HUMAN") @map("author_type") @db.VarChar(20)
  /// One of: UI | MCP
  source      String   @default("UI") @db.VarChar(20)
  /// One of: PENDING | APPROVED | REJECTED. Only meaningful on PLAN entries
  /// (always PENDING on COMMENT rows — approval applies to plans, not
  /// replies). Purely a status marker: approving/rejecting a plan has no
  /// side effects on the parent Solution's status.
  planStatus  String   @default("PENDING") @map("plan_status") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  solution    Solution @relation(fields: [solutionId], references: [id])

  @@map("solution_comments")
}

model Assumption {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solutionId  String       @map("solution_id") @db.Uuid
  title       String       @db.VarChar(255)
  riskLevel   String       @default("MEDIUM") @map("risk_level") @db.VarChar(50)
  status      String       @default("UNTESTED") @db.VarChar(50)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @map("updated_at")
  solution    Solution     @relation(fields: [solutionId], references: [id])
  experiments Experiment[]
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  source      String       @default("UI") @map("source") @db.VarChar(20)
  evidence    Evidence[]

  @@map("assumptions")
}

// ─── Scoring Models ───────────────────────────────────────────────────────────
// Org-level scoring model templates (RICE-style and similar), selected per
// workspace, scoring Opportunities only in v1. See lib/scoring.ts for the
// formula computation semantics. ADR context: Products/Compass/Brainstorm —
// Scoring Models for Discovery Objects — 2026-07-16.md.

model ScoringModel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  /// One of: ACTIVE | ARCHIVED. Archived models are hidden from the workspace
  /// picker for new selections but remain valid for workspaces already using
  /// them and for existing OpportunityScore history.
  status         String   @default("ACTIVE") @db.VarChar(50)
  /// One of: WEIGHTED_SUM | MULTIPLICATIVE. See lib/scoring.ts for the
  /// computation semantics of each.
  formulaType    String   @default("WEIGHTED_SUM") @map("formula_type") @db.VarChar(50)
  /// Bumped by app code (not a DB trigger) whenever the metrics array
  /// changes shape/weights — never on name/description-only edits. Snapshotted
  /// onto every OpportunityScore at scoring time so historical scores are
  /// self-describing even after the live model changes.
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  organization     Organization             @relation(fields: [organizationId], references: [id])
  metrics          ScoringModelMetric[]
  workspaceConfigs WorkspaceScoringConfig[]
  scores           OpportunityScore[]

  @@index([organizationId])
  @@map("scoring_models")
}

model ScoringModelMetric {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scoringModelId String  @map("scoring_model_id") @db.Uuid
  /// Stable machine key referenced in OpportunityScore.rawValues JSON,
  /// e.g. "reach", "impact", "effort". Immutable after creation in practice
  /// (changing it orphans historical rawValues keys) — enforced in the UI by
  /// not allowing key edits after first save, only add/remove/reweight.
  key            String  @db.VarChar(50)
  label          String  @db.VarChar(255)
  description    String? @db.Text
  minValue       Float   @default(0) @map("min_value")
  maxValue       Float   @default(10) @map("max_value")
  /// Scalar multiplier applied to the raw input value before it enters the
  /// formula. Default 1 = faithful classic RICE/ICE (no extra weighting).
  weight         Float   @default(1)
  /// POSITIVE = this metric increases the score (added in WEIGHTED_SUM,
  /// multiplied into the numerator in MULTIPLICATIVE, e.g. Reach/Impact/
  /// Confidence). NEGATIVE = this metric decreases the score (subtracted in
  /// WEIGHTED_SUM, divided into the denominator in MULTIPLICATIVE, e.g.
  /// Effort). This one field drives both formula types — see lib/scoring.ts.
  direction      String  @default("POSITIVE") @db.VarChar(10)
  order          Int     @default(0)

  scoringModel ScoringModel @relation(fields: [scoringModelId], references: [id])

  @@unique([scoringModelId, key])
  @@map("scoring_model_metrics")
}

model WorkspaceScoringConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @unique @map("workspace_id") @db.Uuid
  scoringModelId String?  @map("scoring_model_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  scoringModel ScoringModel? @relation(fields: [scoringModelId], references: [id])

  @@map("workspace_scoring_configs")
}

model OpportunityScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId   String   @unique @map("opportunity_id") @db.Uuid
  scoringModelId  String   @map("scoring_model_id") @db.Uuid
  /// ScoringModel.version at the moment this score was computed. If this no
  /// longer matches the live ScoringModel.version, the UI shows a
  /// "scored under an earlier version" banner rather than silently
  /// recomputing (opt-in re-score, per the versioning decision).
  modelVersion    Int      @map("model_version")
  /// Snapshot of the metric definitions (key/label/min/max/weight/direction)
  /// used to compute this score, so history survives future template edits
  /// without needing a fully versioned ScoringModelMetric table.
  formulaSnapshot Json     @map("formula_snapshot")
  /// { [metricKey]: number } — the raw input values as entered.
  rawValues       Json     @map("raw_values")
  rawScore        Float    @map("raw_score")
  /// 0-100, comparable across workspaces/templates. This is what any
  /// cross-workspace "top opportunities" view sorts on.
  normalizedScore Float    @map("normalized_score")
  scoredAt        DateTime @default(now()) @map("scored_at")
  scoredByUserId  String?  @map("scored_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id])
  scoringModel ScoringModel @relation(fields: [scoringModelId], references: [id])

  @@index([scoringModelId])
  @@map("opportunity_scores")
}

// ─── Experiments ──────────────────────────────────────────────────────────────

model Experiment {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String             @map("workspace_id") @db.Uuid
  squadId       String?            @map("squad_id") @db.Uuid
  assumptionId  String?            @map("assumption_id") @db.Uuid
  title         String             @db.VarChar(255)
  hypothesis    String             @db.Text
  method        String             @db.Text
  killCondition String             @map("kill_condition") @db.Text
  status        String             @default("DESIGNING") @db.VarChar(50)
  sortOrder     Int                @default(0) @map("sort_order")
  startDate     DateTime?          @map("start_date")
  endDate       DateTime?          @map("end_date")
  conclusion    String?            @db.VarChar(50)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @map("updated_at")
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  squad         Squad?             @relation(fields: [squadId], references: [id])
  assumption    Assumption?        @relation(fields: [assumptionId], references: [id])
  results       ExperimentResult[]
  roadmapItems  RoadmapItem[]
  createdById   String?            @map("created_by_id") @db.Uuid
  updatedById   String?            @map("updated_by_id") @db.Uuid
  source        String             @default("UI") @map("source") @db.VarChar(20)

  @@map("experiments")
}

model ExperimentResult {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String     @map("experiment_id") @db.Uuid
  note         String     @db.Text
  metric       String?    @db.VarChar(255)
  value        Float?
  createdAt    DateTime   @default(now()) @map("created_at")
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  createdById  String?    @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  source       String     @default("UI") @map("source") @db.VarChar(20)

  @@map("experiment_results")
}

// ─── Roadmap ──────────────────────────────────────────────────────────────────

model RoadmapItem {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  squadId          String?          @map("squad_id") @db.Uuid
  title            String           @db.VarChar(255)
  description      String?          @db.Text
  horizon          String           @default("NOW") @db.VarChar(50)
  status           String           @default("ACTIVE") @db.VarChar(50)
  isPrivate        Boolean          @default(false) @map("is_private")
  sortOrder        Int              @default(0) @map("sort_order")
  startDate        DateTime?        @map("start_date")
  endDate          DateTime?        @map("end_date")
  solutionId       String?          @map("solution_id") @db.Uuid
  keyResultId      String?          @map("key_result_id") @db.Uuid
  opportunityId    String?          @map("opportunity_id") @db.Uuid
  experimentId     String?          @map("experiment_id") @db.Uuid
  feedbackId       String?          @map("feedback_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @map("updated_at")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id])
  squad            Squad?           @relation(fields: [squadId], references: [id])
  solution         Solution?        @relation(fields: [solutionId], references: [id])
  keyResult        KeyResult?       @relation(fields: [keyResultId], references: [id])
  opportunity      Opportunity?     @relation(fields: [opportunityId], references: [id])
  experiment       Experiment?      @relation(fields: [experimentId], references: [id])
  feedback         FeedbackItem?    @relation(fields: [feedbackId], references: [id])
  votes            RoadmapVote[]
  createdById      String?          @map("created_by_id") @db.Uuid
  updatedById      String?          @map("updated_by_id") @db.Uuid
  source           String           @default("UI") @map("source") @db.VarChar(20)
  launchChecklist  LaunchChecklist?
  positioningBrief Doc?

  @@map("roadmap_items")
}

// ─── Launch Tiers & Checklists ──────────────────────────────────────────────
// Moving a RoadmapItem to the LAUNCHING horizon requires picking a launch
// tier, which auto-attaches a checklist cloned from a workspace-scoped
// template. Mirrors the ScoringModel/ScoringModelMetric → OpportunityScore
// template-vs-instance pattern above: templates are editable named presets,
// checklists are frozen per-launch instances (with a JSON snapshot of the
// template at attach time) so later template edits/archival don't retroactively
// change an in-flight launch's checklist.
// See Claude/2026-07-21-compass-gtm-planning-design.md and
// Claude/2026-07-21-compass-gtm-roadmap-lifecycle-adr.md for design context.

model ChecklistTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// One of: TIER_1 | TIER_2 | TIER_3 (major / minor / silent launch)
  tier        String   @db.VarChar(20)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  /// One of: ACTIVE | ARCHIVED. Archived templates are hidden from
  /// set_launch_tier's auto-resolution but remain valid for any
  /// LaunchChecklist already created from them.
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  workspace  Workspace               @relation(fields: [workspaceId], references: [id])
  items      ChecklistTemplateItem[]
  checklists LaunchChecklist[]

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistTemplateId String  @map("checklist_template_id") @db.Uuid
  label               String  @db.VarChar(255)
  description         String? @db.Text
  order               Int     @default(0)

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])

  @@map("checklist_template_items")
}

model LaunchChecklist {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapItemId       String   @unique @map("roadmap_item_id") @db.Uuid
  checklistTemplateId String   @map("checklist_template_id") @db.Uuid
  /// Denormalized copy of the template's tier at attach time — survives
  /// template edits/archival.
  tier                String   @db.VarChar(20)
  /// JSON-encoded (TEXT, not a Json column — matches the formula_snapshot
  /// convention in migration 019_scoring_models) snapshot of the template +
  /// its items at attach time, so historical checklists are self-describing
  /// even after the live template changes.
  templateSnapshot    String   @map("template_snapshot") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  roadmapItem       RoadmapItem           @relation(fields: [roadmapItemId], references: [id])
  checklistTemplate ChecklistTemplate     @relation(fields: [checklistTemplateId], references: [id])
  items             LaunchChecklistItem[]

  @@map("launch_checklists")
}

model LaunchChecklistItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  launchChecklistId String    @map("launch_checklist_id") @db.Uuid
  label             String    @db.VarChar(255)
  description       String?   @db.Text
  /// Tri-state (not boolean) so a SKIPPED item doesn't falsely register as
  /// blocking a later launch-readiness gate. One of: PENDING | DONE | SKIPPED.
  status            String    @default("PENDING") @db.VarChar(20)
  order             Int       @default(0)
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  launchChecklist LaunchChecklist @relation(fields: [launchChecklistId], references: [id])

  @@map("launch_checklist_items")
}

// ─── Squads ───────────────────────────────────────────────────────────────────

model Squad {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  name          String        @db.VarChar(255)
  color         String        @default("#6366f1") @db.VarChar(50)
  createdAt     DateTime      @default(now()) @map("created_at")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  objectives    Objective[]
  opportunities Opportunity[]
  experiments   Experiment[]
  roadmapItems  RoadmapItem[]
  tasks         Task[]
  createdById   String?       @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  source        String        @default("UI") @map("source") @db.VarChar(20)

  @@map("squads")
}

// ─── Custom Fields ────────────────────────────────────────────────────────────

model CustomFieldDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// One of: OPPORTUNITY | SOLUTION | EXPERIMENT | OBJECTIVE | KEY_RESULT | ROADMAP_ITEM | TASK
  objectType  String   @map("object_type") @db.VarChar(50)
  name        String   @db.VarChar(255)
  /// One of: TEXT | NUMBER | DATE | SELECT | MULTI_SELECT | URL | BOOLEAN
  fieldType   String   @map("field_type") @db.VarChar(50)
  /// For SELECT / MULTI_SELECT: JSON array of { label: string; value: string; color?: string }
  options     Json?
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  values      CustomFieldValue[]
  createdById String?            @map("created_by_id") @db.Uuid
  updatedById String?            @map("updated_by_id") @db.Uuid
  source      String             @default("UI") @map("source") @db.VarChar(20)

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  objectId  String   @map("object_id") @db.Uuid
  /// Flexible storage: string | number | boolean | string[] | null
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id])

  @@unique([fieldId, objectId])
  @@map("custom_field_values")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(255)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix  String    @map("key_prefix") @db.VarChar(8)
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([keyPrefix])
  @@map("api_keys")
}

// ─── Portal Auth (fully independent of User/Session/VerificationToken) ────────
// See ADR: Claude/compass-portal-auth-adr-2026-07-03.md
// Portal accounts/sessions are intentionally non-interoperable with Auth.js.
// Do not add a FK to User. Do not reuse authjs.session-token.

model PortalAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  name          String?  @db.VarChar(255)
  emailVerified DateTime @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  sessions      PortalSession[]
  feedbackItems FeedbackItem[]
  feedbackVotes FeedbackVote[]
  roadmapVotes  RoadmapVote[]

  @@map("portal_accounts")
}

model PortalSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portalAccountId String        @map("portal_account_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  lastUsedAt      DateTime      @default(now()) @map("last_used_at")
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id])

  @@index([portalAccountId])
  @@map("portal_sessions")
}

// Magic-link verification tokens for portal signup/login.
// Deliberately a separate table from Auth.js's VerificationToken —
// same reason as everything else in this ADR: no shared code path.
model PortalVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("portal_verification_tokens")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model FeedbackItem {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  opportunityId   String?              @map("opportunity_id") @db.Uuid
  title           String               @db.VarChar(255)
  description     String?              @db.Text
  type            String               @default("IDEA") @db.VarChar(50)
  submitterName   String?              @map("submitter_name") @db.VarChar(255)
  submitterEmail  String?              @map("submitter_email") @db.VarChar(255)
  portalAccountId String?              @map("portal_account_id") @db.Uuid
  status          String               @default("OPEN") @db.VarChar(50)
  voteCount       Int                  @default(0) @map("vote_count")
  tags            Json?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @map("updated_at")
  workspace       Workspace            @relation(fields: [workspaceId], references: [id])
  opportunity     Opportunity?         @relation(fields: [opportunityId], references: [id])
  portalAccount   PortalAccount?       @relation(fields: [portalAccountId], references: [id])
  votes           FeedbackVote[]
  roadmapItems    RoadmapItem[]
  createdById     String?              @map("created_by_id") @db.Uuid
  updatedById     String?              @map("updated_by_id") @db.Uuid
  source          String               @default("UI") @map("source") @db.VarChar(20)
  attachments     FeedbackAttachment[]

  @@map("feedback")
}

model FeedbackAttachment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackItemId String       @map("feedback_item_id") @db.Uuid
  url            String       @db.Text
  filename       String       @db.VarChar(255)
  fileType       String       @map("file_type") @db.VarChar(100)
  fileSize       Int          @map("file_size")
  createdAt      DateTime     @default(now()) @map("created_at")
  feedbackItem   FeedbackItem @relation(fields: [feedbackItemId], references: [id])

  @@index([feedbackItemId])
  @@map("feedback_attachment")
}

model FeedbackVote {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId      String         @map("feedback_id") @db.Uuid
  voterEmail      String         @map("voter_email") @db.VarChar(255)
  portalAccountId String?        @map("portal_account_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  feedbackItem    FeedbackItem   @relation(fields: [feedbackId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  @@unique([feedbackId, voterEmail])
  @@map("feedback_votes")
}

// ─── Docs ─────────────────────────────────────────────────────────────────────

model Doc {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  parentId      String?      @map("parent_id") @db.Uuid
  title         String       @db.VarChar(255)
  content       String?      @db.Text
  metadata      Json?        @map("metadata") @db.Json
  icon          String?      @db.VarChar(50)
  sortOrder     Int          @default(0) @map("sort_order")
  /// UUID of the RoadmapItem this doc is a Positioning & Messaging Brief for,
  /// 1:1 (unique). Null for ordinary docs. See docType.
  roadmapItemId String?      @unique @map("roadmap_item_id") @db.Uuid
  /// One of: STANDARD | GTM_POSITIONING_BRIEF. Drives whether create_doc
  /// auto-fills GTM_POSITIONING_BRIEF_TEMPLATE and whether roadmapItemId is
  /// meaningful.
  docType       String       @default("STANDARD") @map("doc_type") @db.VarChar(50)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  parent        Doc?         @relation("DocParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children      Doc[]        @relation("DocParent")
  roadmapItem   RoadmapItem? @relation(fields: [roadmapItemId], references: [id])
  createdById   String?      @map("created_by_id") @db.Uuid
  updatedById   String?      @map("updated_by_id") @db.Uuid
  source        String       @default("UI") @map("source") @db.VarChar(20)
  versions      DocVersion[]
  comments      DocComment[]

  @@map("docs")
}

/// Inline anchored comment on a Doc (Google-Docs-style). Threads are exactly
/// one level deep: a root comment (parentId null) optionally carries an anchor
/// into the doc's plain-text projection; replies (parentId set) never carry an
/// anchor. Anchors are NEVER embedded in Doc.content -- the markdown stays
/// untouched. The highlight is resolved at render time (see
/// lib/comment-anchor.ts + components/docs/comment-highlight-extension.ts).
/// No relationMode cascade on DSQL -- deleting a root must deleteMany its
/// replies first, and deleteDoc must bulk-delete this table's rows for a doc
/// before deleting the Doc row itself.
model DocComment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docId        String       @map("doc_id") @db.Uuid
  parentId     String?      @map("parent_id") @db.Uuid
  body         String       @db.Text
  status       String       @default("OPEN") @map("status") @db.VarChar(20)
  anchorText   String?      @map("anchor_text") @db.Text
  anchorPrefix String?      @map("anchor_prefix") @db.VarChar(100)
  anchorSuffix String?      @map("anchor_suffix") @db.VarChar(100)
  anchorStart  Int?         @map("anchor_start")
  anchorEnd    Int?         @map("anchor_end")
  authorName   String       @map("author_name") @db.VarChar(255)
  authorId     String?      @map("author_id") @db.Uuid
  authorType   String       @default("HUMAN") @map("author_type") @db.VarChar(20)
  source       String       @default("UI") @map("source") @db.VarChar(20)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")
  doc          Doc          @relation(fields: [docId], references: [id])
  parent       DocComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies      DocComment[] @relation("CommentReplies")

  @@index([docId, status])
  @@map("doc_comments")
}

/// Point-in-time snapshot of a Doc's content, taken automatically right before
/// an overwriting save (coalesced -- see lib/doc-versions.ts) or explicitly via
/// a "named" manual snapshot (label set, always written, never coalesced).
/// Insert-only: rows are never updated, only created and (on doc deletion)
/// bulk-deleted. No relationMode cascade on DSQL -- deleteDoc must delete
/// this table's rows for a doc before deleting the Doc row itself.
model DocVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docId         String   @map("doc_id") @db.Uuid
  title         String   @db.VarChar(255)
  content       String?  @db.Text
  metadata      Json?    @db.Json
  icon          String?  @db.VarChar(50)
  /// Set only on manual "named" snapshots (bypasses coalescing). Null for
  /// ordinary auto-snapshots taken before an overwriting save.
  label         String?  @db.VarChar(100)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  doc           Doc      @relation(fields: [docId], references: [id])

  @@index([docId, createdAt])
  @@map("doc_versions")
}

// ─── Canvas Viewer ────────────────────────────────────────────────────────────
// Phase 1 (this model ships now, unpopulated — no drag-to-pin UI yet, see
// Claude/compass-canvas-viewer-design-2026-07-21.md §8). A row only ever
// exists once a user explicitly pins a node's position; pinned defaults true
// so the flag is ready for a future unpin-as-update path instead of forcing
// delete/recreate races. Phase 2 requirement (not yet implemented): every
// hard-delete path for a pinnable entity (deleteObjective, deleteKeyResult)
// must delete its CanvasNodePosition row first, following the deleteSquad
// no-cascade-cleanup precedent — moot in Phase 1 since no row can exist yet.

model CanvasNodePosition {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  /// One of: OBJECTIVE | KEY_RESULT | OPPORTUNITY | SOLUTION | ASSUMPTION |
  /// EXPERIMENT | ROADMAP_ITEM — see CanvasEntityType in lib/types.ts. No
  /// writer exists yet (drag-to-pin UI is still deferred), so this table
  /// stays empty in practice, but every entity type is queryable already.
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String    @map("entity_id") @db.Uuid
  x           Float
  y           Float
  pinned      Boolean   @default(true)
  updatedAt   DateTime  @default(now()) @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid

  @@unique([workspaceId, entityType, entityId])
  @@map("canvas_node_positions")
}

// ─── Evidence ─────────────────────────────────────────────────────────────────

model Evidence {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  /// One of: interview | feedback | support_ticket | experiment_result | analytics
  sourceType    String       @map("source_type") @db.VarChar(50)
  excerpt       String       @db.Text
  sourceUrl     String?      @map("source_url") @db.VarChar(2048)
  /// One of: high | medium | low
  confidence    String       @default("medium") @db.VarChar(50)
  opportunityId String?      @map("opportunity_id") @db.Uuid
  solutionId    String?      @map("solution_id") @db.Uuid
  assumptionId  String?      @map("assumption_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  solution      Solution?    @relation(fields: [solutionId], references: [id])
  assumption    Assumption?  @relation(fields: [assumptionId], references: [id])

  @@map("evidence")
}

model RoadmapVote {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapItemId   String         @map("roadmap_item_id") @db.Uuid
  voterEmail      String         @map("voter_email") @db.VarChar(255)
  voterName       String?        @map("voter_name") @db.VarChar(255)
  portalAccountId String?        @map("portal_account_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  roadmapItem     RoadmapItem    @relation(fields: [roadmapItemId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  @@unique([roadmapItemId, voterEmail])
  @@map("roadmap_votes")
}

// ─── Tasks (Sprint Delivery + PM Initiative Tracking) ──────────────────────────
// Standalone top-level entity. Same status vocabulary serves two very different
// audiences — see TaskStatus in lib/types.ts for how a lightweight PM-tracker
// view and a full engineering Kanban/Scrum board both render off this one field.
// Links to other Compass objects are many-to-many via TaskLink (see below),
// NOT via nullable FK columns on this row — a Task can touch a Solution and a
// Doc and a KeyResult at once. See Claude/compass-task-tracker-design-2026-07-31.md.

model Task {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  squadId        String?   @map("squad_id") @db.Uuid
  parentTaskId   String?   @map("parent_task_id") @db.Uuid
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  /// One of: BACKLOG | TODO | IN_PROGRESS | BLOCKED | IN_REVIEW | DONE | CANCELLED.
  /// BLOCKED is a first-class status column — not an orthogonal flag. Same
  /// vocabulary for full engineering delivery and lightweight PM initiative
  /// tracking — the UI, not the schema, decides which subset of statuses
  /// renders as board columns. See lib/types.ts TaskStatus.
  status         String    @default("TODO") @db.VarChar(50)
  /// One of: URGENT | HIGH | MEDIUM | LOW.
  priority       String    @default("MEDIUM") @db.VarChar(20)
  /// Nullable UUID of a WorkspaceMember's userId. No @relation — same
  /// reasoning as createdById/updatedById elsewhere in this schema: it's
  /// resolved against WorkspaceMember at the app layer, not joined by Prisma.
  assigneeUserId String?   @map("assignee_user_id") @db.Uuid
  /// Freeform owner name for PM-initiative tracking where the responsible party
  /// isn't a Compass WorkspaceMember (external stakeholder, exec, etc.). Either
  /// or both of assigneeUserId / ownerName may be set.
  ownerName      String?   @map("owner_name") @db.VarChar(255)
  storyPoints    Float?    @map("story_points")
  dueDate        DateTime? @map("due_date")
  /// Freeform sprint/iteration label (e.g. "Sprint 24", "2026-W31"). Reserved
  /// extension point for a future first-class Sprint entity.
  iteration      String?   @db.VarChar(100)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  squad      Squad?     @relation(fields: [squadId], references: [id])
  parentTask Task?      @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subtasks   Task[]     @relation("TaskParent")
  links      TaskLink[]

  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid
  source      String  @default("UI") @map("source") @db.VarChar(20)

  @@index([workspaceId, status])
  @@index([squadId])
  @@index([parentTaskId])
  @@index([assigneeUserId])
  @@map("tasks")
}

// ─── Task Links (polymorphic many-to-many) ─────────────────────────────────
// Deliberately NOT shaped like Evidence (mutually-exclusive nullable FK
// columns, one parent per row) — a Task can relate to MULTIPLE objects across
// MULTIPLE types at once (e.g. one Task tied to both a Solution and a Doc).
// One row per (task, linked object) pair. linkedId carries no Prisma
// @relation because a single UUID column can't type-safely join into eight
// different target tables — same reasoning as CustomFieldValue.objectId
// above. Cross-type reads are resolved in application code (group links by
// linkedType, batch-fetch each type, stitch results back together), not via
// a single Prisma `include`.

model TaskLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  /// One of: OPPORTUNITY | SOLUTION | ROADMAP_ITEM | OBJECTIVE | KEY_RESULT |
  /// DOC | EXPERIMENT | FEEDBACK_ITEM. Squad is deliberately excluded — a
  /// Task's squad is its first-class owning Task.squadId column, not a
  /// generic link.
  linkedType  String   @map("linked_type") @db.VarChar(30)
  linkedId    String   @map("linked_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.Uuid
  source      String   @default("UI") @map("source") @db.VarChar(20)

  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, linkedType, linkedId])
  @@index([linkedType, linkedId])
  @@map("task_links")
}

// ─── In-app agent runtime ────────────────────────────────────────────────────

/// Deployment-global singleton holding the current "golden" Vercel Sandbox
/// snapshot that the in-app agent runtime boots from, so each agent turn skips
/// `npm install` (~10s → ~200ms). Exactly one row, keyed by scope = "global".
/// Rebuilt via POST /api/admin/rebuild-agent-snapshot when the sandbox deps
/// change. See docs/decisions/0001-in-app-agent-architecture.md §3.
///
/// DSQL: no FKs; no @updatedAt trigger (updatedAt set explicitly in app code).
model AgentRuntimeConfig {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Singleton discriminator — always "global"; the @unique guarantees one row.
  scope            String    @unique @default("global") @db.VarChar(20)
  /// Vercel Sandbox snapshot id agent turns boot from; null until first build.
  goldenSnapshotId String?   @map("golden_snapshot_id") @db.VarChar(255)
  /// SHA-256 of the sandbox deps package.json at build time — detects drift.
  depsFingerprint  String?   @map("deps_fingerprint") @db.VarChar(64)
  /// When the current golden snapshot was built.
  snapshotBuiltAt  DateTime? @map("snapshot_built_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  @@map("agent_runtime_config")
}

// ─── In-app agent conversations ──────────────────────────────────────────────

/// A chat conversation between a user and the in-app agent, scoped to one
/// workspace. History + per-turn usage live in AgentMessage. Access is gated
/// by workspace membership + ownership in the session-authed turn route
/// (not via MCP). See docs/decisions/0001-in-app-agent-architecture.md Phase 3.
/// DSQL: no FKs, no @updatedAt (set explicitly), no JSON columns.
model AgentConversation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  messages  AgentMessage[]

  @@index([workspaceId, userId])
  @@map("agent_conversations")
}

/// One message in an AgentConversation. `role` is "user" | "assistant".
/// Assistant rows also carry usage/cost for the turn. The raw structured event
/// trace, if kept, is stored JSON-encoded as TEXT (formula_snapshot convention)
/// — never a JSON column (DSQL).
model AgentMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.VarChar(20)
  content        String   @db.Text
  /// Usage/cost (assistant turns only; null for user messages).
  model          String?  @db.VarChar(100)
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  numTurns       Int?     @map("num_turns")
  costUsd        Float?   @map("cost_usd")
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

/// Append-only audit trail of agent-initiated mutation tool calls (ADR 0001,
/// Phase 5). One row per mutating MCP tool the agent invoked on a user's
/// behalf. DSQL: no FKs; TEXT for the JSON-encoded args summary; no @updatedAt
/// (append-only).
model AgentAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  toolName       String   @map("tool_name") @db.VarChar(100)
  /// JSON-encoded, truncated summary of the tool input (TEXT, not a JSON column).
  argsSummary    String?  @map("args_summary") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("agent_audit_log")
}
