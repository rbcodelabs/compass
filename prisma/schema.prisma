generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────
// DSQL constraints applied:
//  - UUID PKs via gen_random_uuid()
//  - No @updatedAt (DSQL does not support trigger-based auto-update)
//  - relationMode = "prisma" already set — no FK constraints generated

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")

  organizationMembers OrganizationMember[]
  workspaceMembers    WorkspaceMember[]
  apiKeys             ApiKey[]

  @@map("users")
}

model Account {
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id])
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(100)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?  @db.VarChar(50)
  scope             String?
  id_token          String?
  session_state     String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(512)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(512)
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Multi-tenancy ────────────────────────────────────────────────────────────

model Organization {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String               @unique @db.VarChar(255)
  name       String               @db.VarChar(255)
  createdAt  DateTime             @default(now()) @map("created_at")
  workspaces Workspace[]
  members    OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @default("MEMBER") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Workspace {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  slug               String            @db.VarChar(255)
  name               String            @db.VarChar(255)
  description        String?           @db.Text
  feedbackEnabled    Boolean?          @default(false) @map("feedback_enabled")
  roadmapPublic      Boolean?          @default(false) @map("roadmap_public")
  portalAuthRequired Boolean?          @default(false) @map("portal_auth_required")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id])
  members           WorkspaceMember[]
  okrCycles         OKRCycle[]
  opportunities     Opportunity[]
  experiments       Experiment[]
  roadmapItems      RoadmapItem[]
  customFieldDefs   CustomFieldDefinition[]
  squads            Squad[]
  feedback          FeedbackItem[]
  docs              Doc[]

  @@unique([organizationId, slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("MEMBER") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ─── OKRs ─────────────────────────────────────────────────────────────────────

model OKRCycle {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  title       String      @db.VarChar(255)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  status      String      @default("DRAFT") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @map("updated_at")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  objectives  Objective[]

  @@map("okr_cycles")
}

model Objective {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId           String      @map("cycle_id") @db.Uuid
  squadId           String?     @map("squad_id") @db.Uuid
  parentKeyResultId String?     @map("parent_key_result_id") @db.Uuid
  title             String      @db.VarChar(255)
  description       String?     @db.Text
  owner             String?     @db.VarChar(255)
  status            String      @default("ON_TRACK") @db.VarChar(50)
  sortOrder         Int         @default(0) @map("sort_order")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @map("updated_at")
  cycle             OKRCycle    @relation(fields: [cycleId], references: [id])
  squad             Squad?      @relation(fields: [squadId], references: [id])
  parentKeyResult   KeyResult?  @relation("SquadKRSupport", fields: [parentKeyResultId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyResults        KeyResult[]
  createdById       String?     @map("created_by_id") @db.Uuid
  updatedById       String?     @map("updated_by_id") @db.Uuid
  source            String      @default("UI") @map("source") @db.VarChar(20)

  @@map("objectives")
}

model KeyResult {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectiveId          String        @map("objective_id") @db.Uuid
  title                String        @db.VarChar(255)
  target               Float
  current              Float         @default(0)
  unit                 String?       @db.VarChar(50)
  sortOrder            Int           @default(0) @map("sort_order")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @map("updated_at")
  objective            Objective     @relation(fields: [objectiveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkIns             CheckIn[]
  roadmapItems         RoadmapItem[]
  opportunities        Opportunity[]
  supportingObjectives Objective[]   @relation("SquadKRSupport")
  createdById          String?       @map("created_by_id") @db.Uuid
  updatedById          String?       @map("updated_by_id") @db.Uuid
  source               String        @default("UI") @map("source") @db.VarChar(20)

  @@map("key_results")
}

model CheckIn {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyResultId String    @map("key_result_id") @db.Uuid
  value       Float
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id])
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  source      String    @default("UI") @map("source") @db.VarChar(20)

  @@map("check_ins")
}

// ─── Discovery / OST ──────────────────────────────────────────────────────────

model Opportunity {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  squadId           String?        @map("squad_id") @db.Uuid
  title             String         @db.VarChar(255)
  description       String?        @db.Text
  customerSegment   String?        @map("customer_segment") @db.VarChar(255)
  status            String         @default("EXPLORING") @db.VarChar(50)
  sortOrder         Int            @default(0) @map("sort_order")
  linkedKeyResultId String?        @map("linked_key_result_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @default(now()) @map("updated_at")
  workspace         Workspace      @relation(fields: [workspaceId], references: [id])
  squad             Squad?         @relation(fields: [squadId], references: [id])
  linkedKeyResult   KeyResult?     @relation(fields: [linkedKeyResultId], references: [id])
  solutions         Solution[]
  roadmapItems      RoadmapItem[]
  feedback          FeedbackItem[]
  createdById       String?        @map("created_by_id") @db.Uuid
  updatedById       String?        @map("updated_by_id") @db.Uuid
  source            String         @default("UI") @map("source") @db.VarChar(20)

  @@map("opportunities")
}

model Solution {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId String        @map("opportunity_id") @db.Uuid
  title         String        @db.VarChar(255)
  description   String?       @db.Text
  status        String        @default("IDEA") @db.VarChar(50)
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @map("updated_at")
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id])
  assumptions   Assumption[]
  roadmapItems  RoadmapItem[]
  createdById   String?       @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  source        String        @default("UI") @map("source") @db.VarChar(20)

  @@map("solutions")
}

model Assumption {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solutionId  String       @map("solution_id") @db.Uuid
  title       String       @db.VarChar(255)
  riskLevel   String       @default("MEDIUM") @map("risk_level") @db.VarChar(50)
  status      String       @default("UNTESTED") @db.VarChar(50)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @map("updated_at")
  solution    Solution     @relation(fields: [solutionId], references: [id])
  experiments Experiment[]
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  source      String       @default("UI") @map("source") @db.VarChar(20)

  @@map("assumptions")
}

// ─── Experiments ──────────────────────────────────────────────────────────────

model Experiment {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String             @map("workspace_id") @db.Uuid
  squadId       String?            @map("squad_id") @db.Uuid
  assumptionId  String?            @map("assumption_id") @db.Uuid
  title         String             @db.VarChar(255)
  hypothesis    String             @db.Text
  method        String             @db.Text
  killCondition String             @map("kill_condition") @db.Text
  status        String             @default("DESIGNING") @db.VarChar(50)
  sortOrder     Int                @default(0) @map("sort_order")
  startDate     DateTime?          @map("start_date")
  endDate       DateTime?          @map("end_date")
  conclusion    String?            @db.VarChar(50)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @map("updated_at")
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  squad         Squad?             @relation(fields: [squadId], references: [id])
  assumption    Assumption?        @relation(fields: [assumptionId], references: [id])
  results       ExperimentResult[]
  roadmapItems  RoadmapItem[]
  createdById   String?            @map("created_by_id") @db.Uuid
  updatedById   String?            @map("updated_by_id") @db.Uuid
  source        String             @default("UI") @map("source") @db.VarChar(20)

  @@map("experiments")
}

model ExperimentResult {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String     @map("experiment_id") @db.Uuid
  note         String     @db.Text
  metric       String?    @db.VarChar(255)
  value        Float?
  createdAt    DateTime   @default(now()) @map("created_at")
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  createdById  String?    @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  source       String     @default("UI") @map("source") @db.VarChar(20)

  @@map("experiment_results")
}

// ─── Roadmap ──────────────────────────────────────────────────────────────────

model RoadmapItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String      @map("workspace_id") @db.Uuid
  squadId       String?     @map("squad_id") @db.Uuid
  title         String      @db.VarChar(255)
  description   String?     @db.Text
  horizon       String      @default("NOW") @db.VarChar(50)
  status        String      @default("ACTIVE") @db.VarChar(50)
  sortOrder     Int         @default(0) @map("sort_order")
  startDate     DateTime?   @map("start_date")
  endDate       DateTime?   @map("end_date")
  solutionId    String?     @map("solution_id") @db.Uuid
  keyResultId   String?     @map("key_result_id") @db.Uuid
  opportunityId String?     @map("opportunity_id") @db.Uuid
  experimentId  String?     @map("experiment_id") @db.Uuid
  feedbackId    String?     @map("feedback_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @map("updated_at")
  workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  squad         Squad?      @relation(fields: [squadId], references: [id])
  solution      Solution?   @relation(fields: [solutionId], references: [id])
  keyResult     KeyResult?  @relation(fields: [keyResultId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  experiment    Experiment?  @relation(fields: [experimentId], references: [id])
  feedback      FeedbackItem? @relation(fields: [feedbackId], references: [id])
  votes         RoadmapVote[]
  createdById   String?       @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  source        String        @default("UI") @map("source") @db.VarChar(20)

  @@map("roadmap_items")
}

// ─── Squads ───────────────────────────────────────────────────────────────────

model Squad {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  name          String        @db.VarChar(255)
  color         String        @default("#6366f1") @db.VarChar(50)
  createdAt     DateTime      @default(now()) @map("created_at")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  objectives    Objective[]
  opportunities Opportunity[]
  experiments   Experiment[]
  roadmapItems  RoadmapItem[]
  createdById   String?       @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  source        String        @default("UI") @map("source") @db.VarChar(20)

  @@map("squads")
}

// ─── Custom Fields ────────────────────────────────────────────────────────────

model CustomFieldDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// One of: OPPORTUNITY | SOLUTION | EXPERIMENT | OBJECTIVE | KEY_RESULT | ROADMAP_ITEM
  objectType  String   @map("object_type") @db.VarChar(50)
  name        String   @db.VarChar(255)
  /// One of: TEXT | NUMBER | DATE | SELECT | MULTI_SELECT | URL | BOOLEAN
  fieldType   String   @map("field_type") @db.VarChar(50)
  /// For SELECT / MULTI_SELECT: JSON array of { label: string; value: string; color?: string }
  options     Json?
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  values      CustomFieldValue[]
  createdById String?            @map("created_by_id") @db.Uuid
  updatedById String?            @map("updated_by_id") @db.Uuid
  source      String             @default("UI") @map("source") @db.VarChar(20)

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  objectId  String   @map("object_id") @db.Uuid
  /// Flexible storage: string | number | boolean | string[] | null
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id])

  @@unique([fieldId, objectId])
  @@map("custom_field_values")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(255)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix  String    @map("key_prefix") @db.VarChar(8)
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([keyPrefix])
  @@map("api_keys")
}

// ─── Portal Auth (fully independent of User/Session/VerificationToken) ────────
// See ADR: Claude/compass-portal-auth-adr-2026-07-03.md
// Portal accounts/sessions are intentionally non-interoperable with Auth.js.
// Do not add a FK to User. Do not reuse authjs.session-token.

model PortalAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  name          String?  @db.VarChar(255)
  emailVerified DateTime @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  sessions      PortalSession[]
  feedbackItems FeedbackItem[]
  feedbackVotes FeedbackVote[]
  roadmapVotes  RoadmapVote[]

  @@map("portal_accounts")
}

model PortalSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portalAccountId String        @map("portal_account_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  lastUsedAt      DateTime      @default(now()) @map("last_used_at")
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id])

  @@index([portalAccountId])
  @@map("portal_sessions")
}

// Magic-link verification tokens for portal signup/login.
// Deliberately a separate table from Auth.js's VerificationToken —
// same reason as everything else in this ADR: no shared code path.
model PortalVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("portal_verification_tokens")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model FeedbackItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  opportunityId   String?   @map("opportunity_id") @db.Uuid
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  type            String    @default("IDEA") @db.VarChar(50)
  submitterName   String?   @map("submitter_name") @db.VarChar(255)
  submitterEmail  String?   @map("submitter_email") @db.VarChar(255)
  portalAccountId String?   @map("portal_account_id") @db.Uuid
  status          String    @default("OPEN") @db.VarChar(50)
  voteCount       Int       @default(0) @map("vote_count")
  tags            Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")
  workspace       Workspace   @relation(fields: [workspaceId], references: [id])
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])
  votes           FeedbackVote[]
  roadmapItems    RoadmapItem[]
  createdById     String?   @map("created_by_id") @db.Uuid
  updatedById     String?   @map("updated_by_id") @db.Uuid
  source          String    @default("UI") @map("source") @db.VarChar(20)

  @@map("feedback")
}

model FeedbackVote {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId      String       @map("feedback_id") @db.Uuid
  voterEmail      String       @map("voter_email") @db.VarChar(255)
  portalAccountId String?      @map("portal_account_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  feedbackItem    FeedbackItem @relation(fields: [feedbackId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  @@unique([feedbackId, voterEmail])
  @@map("feedback_votes")
}

// ─── Docs ─────────────────────────────────────────────────────────────────────

model Doc {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  title       String    @db.VarChar(255)
  content     String?   @db.Text
  metadata    Json?     @map("metadata") @db.Json
  icon        String?   @db.VarChar(50)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  parent      Doc?      @relation("DocParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children    Doc[]     @relation("DocParent")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  source      String    @default("UI") @map("source") @db.VarChar(20)

  @@map("docs")
}

model RoadmapVote {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapItemId   String      @map("roadmap_item_id") @db.Uuid
  voterEmail      String      @map("voter_email") @db.VarChar(255)
  voterName       String?     @map("voter_name") @db.VarChar(255)
  portalAccountId String?     @map("portal_account_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  roadmapItem     RoadmapItem @relation(fields: [roadmapItemId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  @@unique([roadmapItemId, voterEmail])
  @@map("roadmap_votes")
}
