#!/bin/sh
#
# Compass pre-commit hook — scans the staged snapshot with gitleaks.
#
# Enable with:  pnpm hooks:install
# Disable with: pnpm hooks:uninstall
#
# A complete index snapshot preserves multiline context and never substitutes
# unstaged working-tree edits for the content actually being committed.
# CI independently scans history, including commits made with --no-verify.

set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '[pre-commit] COMMIT BLOCKED: gitleaks not installed.\n' >&2
  printf '             Install it with: brew install gitleaks\n' >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/compass-staged-secrets.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM
git -C "$repo_root" checkout-index --all --prefix="$snapshot/"

# Read the scanner policy from the index too: unstaged config changes must not
# weaken the scan. Historical fingerprints have commit IDs and cannot exempt
# a directory-scan finding in this new snapshot.
if gitleaks dir "$snapshot" \
  --config "$snapshot/.gitleaks.toml" \
  --gitleaks-ignore-path "$snapshot" \
  --redact \
  --verbose \
  --no-banner \
  --log-level error \
  --exit-code 1; then
  exit 0
fi

cat >&2 <<'EOF'

────────────────────────────────────────────────────────────────────────
  COMMIT BLOCKED — possible secret or scanner error in the staged snapshot.
  Values are redacted. Resolve the finding or scanner error before retrying.

  If it IS a real secret:
    1. Remove it from the code and commit again.
    2. Rotate the credential — assume it is burned.
    3. If already pushed, revocation is essential. History rewriting is
       optional after revocation and cannot remove copies in forks/caches.

  If it is a FALSE POSITIVE, pick the narrowest fix:
    - Add a `gitleaks:allow` trailing comment on that specific line, or
    - Add a scoped allowlist to .gitleaks.toml, matching the exact value or
      line shape — never a blanket path or a disabled rule.

  To bypass in an emergency (CI will still catch it):
      git commit --no-verify
────────────────────────────────────────────────────────────────────────

EOF
exit 1
